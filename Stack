//This function solves the precedence problem and solves the operator which has higher precedence first.
int precedence(char op) {
    if (op == '+' || op == '-')
        return 1;
    if (op == '*' || op == '/')
        return 2;
    return 0;
}

//This function basically read the operator and then decide what operation to perform and push in the stack.
void apply(stack<int>& values, stack<char>& ops) {
    int b = values.top();
    values.pop();

    int a = values.top();
    values.pop();

    char op = ops.top();
    ops.pop();

    switch(op) {
        case '+': values.push(a + b); break;
        case '-': values.push(a - b); break;
        case '*': values.push(a * b); break;
        case '/': values.push(a / b); break;
    }
}

//This function read the fucntion and pushes the values and operations in two different stacks. It also initiates the solving of the expression.
int evaluateExpression( string str ) {
    stack<int> values;
    stack<char> ops;

    for ( char c : str) {
        if (isdigit(c)) {
            values.push(c - '0');
        }
        else {
            while (!ops.empty() &&
                precedence(ops.top()) >= precedence(c)) {
                apply(values, ops);
            }
            ops.push(c);
        }
    }

    while (!ops.empty()) {
        apply(values, ops);
    }

    return values.top();
}
