In one stack post order traversal we use the the lastVisited variable-
->First sre the usual steps initialising stack, current, and also lastVisited variable.
->We pusht the root into the stack and move to the very left of the tree and process them.
->The node we process we mark it as lastVisted = node.
->If after process we check the lastVisited is on left subtree and node->right is there. It means that rigt needs to be processed and the currene moves to node->right.
->The data is stored in ans array and top is popped one by one.
->Once the lastVisited moves to right the process is complete

<--------------------------------------------------->
vector<int> iterativePostorder1(TreeNode* root) {
    vector<int> ans;
    stack<TreeNode*> st;
    if (root == NULL) return ans;

    TreeNode* curr = root;
    TreeNode* lastVisited = nullptr;

    while (curr || !st.empty()) {
        if (curr) {
            st.push(root);
            curr = curr->left;
        } else {
            TreeNode* node = st.top();

            if (node->right && lastVisited != node->right) {
                curr = node -> right;
            } else {
                ans.push_back(node->data);
                lastVisited = node;
                st.pop();
            }
        }
    }
    return ans;
}
