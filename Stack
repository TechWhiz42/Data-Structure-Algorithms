In iterative Inorder-
->we initialse stack, curret and also a dynamic array ans.
->while current is true and stack is not empty we push the root node into the stack.
->Then we move to the very left of the tree.
->Here the pointer current is on the top of the stack and we pop it.
->We push the data of the current pointer into the ans array.
-> After that we move right of the node and repeat the process.
->return ans;
<---------------------------------------------------->
vector<int> iterativeInorder(TreeNode* root) {
    vector<int> ans;
    stack<TreeNode*> st;
    TreeNode* curr = root;

    while ( curr || !st.empty()) {
        while (curr) {
            st.push(curr);
            curr = curr->left;
        }
        curr = st.top();
        st.pop();

        cout << curr->data << endl;

        ans.push_back(curr->data);
        curr = curr->right;
    }
    return ans;
}
