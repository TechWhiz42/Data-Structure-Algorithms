A stack is an abstract data structure that holds elements in a sequence using the Last-In-First-Out (LIFO) or First-In-Last-Out(FILO) principle.
It is famously used for solving the mathematical expressions like (1+2*3) as we need to keep in mind the operator precedence which is that "-/+" holds same precedence but it precedence is lower than "* / /" which are same precedence level.
It is also used for problems like parantheses problems. The code below solves that very problem in C++.

<------------------------------------------->
void parenthesisProblem(string str) {
    stack<char> s;

    for (char c : str) {

        if (c == '(' || c == '{' || c == '[') {
            s.push(c);
        }
        else {
            if (s.empty()) {
                cout << "Parentheses are not valid\n";
                return;
            }

            char top = s.top();
            s.pop();

            if ((c == ')' && top != '(') ||
                (c == '}' && top != '{') ||
                (c == ']' && top != '[')) {
                cout << "Parentheses are not valid\n";
                return;
                }
        }
    }



    if (s.empty())
        cout << "Parentheses are valid\n";
    else
        cout << "Parentheses are not valid\n";
}
